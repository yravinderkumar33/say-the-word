{
  "name": "say-the-word",
  "productName": "Say the Word",
  "version": "0.0.1",
  "description": "Local-first dictation for macOS: hold a key, speak, and the text lands where you were typing.",
  "private": true,
  "license": "MIT",
  "author": "Say the Word contributors",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "build:helper": "node scripts/build-helper.mjs",
    "predev": "npm run build:helper",
    "dev": "node scripts/run-from-out.mjs dev electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.worklet.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:helper": "swift test --package-path native/flow-helper",
    "test:helper:integration": "npm run build:helper && node scripts/test-helper.mjs",
    "test:app": "npm run build && node scripts/test-app.mjs",
    "test:e2e": "npm run build && node scripts/test-e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:helper",
    "build": "node scripts/check-out-free.mjs && npm run build:helper && node scripts/third-party-notices.mjs && electron-vite build && node scripts/check-build.mjs",
    "smoke": "npm run build && node scripts/run-from-out.mjs smoke electron . --smoke",
    "pictures": "npm run build && node scripts/capture-ui.mjs",
    "smoke:dev": "npm run build:helper && node scripts/run-from-out.mjs smoke:dev electron-vite dev -- --smoke",
    "setup:signing": "node scripts/setup-signing.mjs",
    "models:download": "tsx --tsconfig tsconfig.node.json scripts/download-model.ts",
    "fixtures": "node scripts/make-fixtures.mjs",
    "icon": "tsx --tsconfig tsconfig.node.json scripts/make-icon.ts",
    "bench:stt": "tsx --tsconfig tsconfig.node.json scripts/bench-stt.ts",
    "bench:storage": "npm run build && node scripts/bench-storage.mjs",
    "pipeline": "tsx --tsconfig tsconfig.node.json scripts/pipeline-cli.ts",
    "eval:stt": "tsx --tsconfig tsconfig.node.json scripts/eval-stt.ts",
    "eval:cleanup": "tsx --tsconfig tsconfig.node.json scripts/eval-cleanup.ts",
    "pack": "node scripts/check-not-running.mjs && npm run build && node scripts/pack.mjs",
    "release": "npm run build && node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/audioworklet": "^0.0.100",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "birpc": "^4.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "p-retry": "^8.0.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.8"
  }
}
